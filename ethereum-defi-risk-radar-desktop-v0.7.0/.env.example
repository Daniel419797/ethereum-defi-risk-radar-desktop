# CLI-only configuration. The desktop app collects these settings in its first-launch UI
# and stores API keys with Electron safeStorage instead of writing them to .env.

TINYFISH_API_KEY=replace_me
TINYFISH_SEARCH_ENDPOINT=https://api.search.tinyfish.ai

# Optional Ethereum Mainnet enrichment + verified-source inspection.
# Uses Etherscan API V2 with chainid=1.
ETHERSCAN_API_KEY=
MAX_ETHERSCAN_LOOKUPS_PER_CANDIDATE=2
INSPECT_VERIFIED_SOURCE=true
MAX_SOURCE_BYTES=2000000
MAX_SOURCE_FINDINGS_PER_CONTRACT=80

# Defensive guardrails
MAX_PAGES_PER_QUERY=1
MIN_PUBLIC_SIGNALS=2
OUTPUT_DIR=reports
