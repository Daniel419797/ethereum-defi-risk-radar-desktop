{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://edid.local/v2/plugin-manifest.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","id","version","minimum_edid_version","capabilities","permissions","entry_point","sha256","publisher"],
  "properties":{
    "schema_version":{"const":1},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "version":{"type":"string","minLength":1},
    "minimum_edid_version":{"type":"string","minLength":1},
    "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["framework-detector","test-runner","security-scanner","browser-provider","cloud-provider","database-provider","observability-provider","reporter"]}},
    "permissions":{"type":"array","uniqueItems":true,"items":{"enum":["read-project","write-evidence","execute-allowlisted","network-allowlisted","read-environment-names"]}},
    "entry_point":{"type":"string","minLength":1},
    "sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "publisher":{"type":"string","minLength":1},
    "signature":{"type":"string"}
  }
}
