{
  "version": 3,
  "task_id": "finding-first-security-review-v2",
  "title": "Evidence-aware finding-first production security review",
  "requirements": [
    {
      "id": "FR-1",
      "text": "Preserve CRITICAL, HIGH, MEDIUM, LOW and INFO severity independently from evidence strength."
    },
    {
      "id": "FR-2",
      "text": "Render HEURISTIC, STRUCTURAL, EXECUTED, REPRODUCED-model and REPRODUCED-fork evidence distinctly."
    },
    {
      "id": "FR-3",
      "text": "Normalize and deduplicate legacy source-review signals without hiding advanced findings."
    },
    {
      "id": "FR-4",
      "text": "Group findings by inspected contract and expose source location, engine, confidence, exploitability verdict, reachability, remediation, mitigations, witness paths, counterexamples, limitations and historical context when available."
    },
    {
      "id": "FR-5",
      "text": "Surface truncation and partial-analysis state separately from security findings."
    },
    {
      "id": "FR-6",
      "text": "Generate JSON, backwards-compatible detailed CSV, protocol summary CSV, row-per-finding CSV and standalone HTML security-review artifacts."
    },
    {
      "id": "FR-7",
      "text": "Retain address redaction, CSV formula-injection protection and HTML escaping across report artifacts."
    },
    {
      "id": "FR-8",
      "text": "Keep Historical Audit Intelligence as supporting context only; it must not elevate evidence strength or claim exploitability."
    },
    {
      "id": "NFR-1",
      "text": "Run build, discovery, protocol UI, audit intelligence, security review, release workflow, native analysis, proof and desktop analysis gates before merge."
    }
  ],
  "checks": [
    {
      "id": "application-check",
      "type": "command",
      "required": true,
      "evidence_kind": "build",
      "requirement_ids": [
        "FR-1",
